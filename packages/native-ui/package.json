{
  "name": "@bairmair/native-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The React Native look shared by the Expo apps: theme tokens, Onest text, icons, buttons, blueprint paper, floor plan view, language provider.",
  "exports": {
    "./theme": "./src/theme.ts",
    "./text": "./src/text.tsx",
    "./icon": "./src/icon.tsx",
    "./button": "./src/button.tsx",
    "./blueprint": "./src/blueprint.tsx",
    "./blueprint-panel": "./src/blueprint-panel.tsx",
    "./floor-plan-view": "./src/floor-plan-view.tsx",
    "./scan-floor-plan": "./src/scan-floor-plan.tsx",
    "./i18n": "./src/i18n.tsx",
    "./text-field": "./src/text-field.tsx",
    "./model-embed": "./src/model-embed.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bairmair/browse": "workspace:*",
    "@bairmair/i18n": "workspace:*",
    "@bairmair/room-model": "workspace:*"
  },
  "peerDependencies": {
    "expo-symbols": "*",
    "react": "^19.0.0",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo": "~58.0.25",
    "expo-symbols": "~58.0.5",
    "i18next": "^27.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "14.0.1",
    "typescript": "~6.0.3"
