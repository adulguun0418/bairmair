{
  "name": "@bairmair/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The RoomPlan scanner shared by the Expo apps. `.`: pure TypeScript (device support, scan state, ids, conversion), unit-tested. `./native`: the scan screen, its intro and on-phone storage (React Native, iOS).",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bairmair/i18n": "workspace:*",
    "@bairmair/native-ui": "workspace:*",
    "@bairmair/room-model": "workspace:*"
  },
  "peerDependencies": {
    "expo-device": "*",
    "expo-file-system": "*",
    "expo-keep-awake": "*",
    "expo-roomplan": "1.3.2",
    "expo-sharing": "*",
    "expo-status-bar": "*",
    "react": "^19.0.0",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo": "~58.0.25",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.4",
    "expo-roomplan": "1.3.2",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "i18next": "^27.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
