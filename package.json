{
  "name": "bairmair",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @bairmair/web dev",
    "dev:mobile": "pnpm --filter @bairmair/mobile dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm --filter @bairmair/web --filter @bairmair/mobile lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:remote": "pnpm --filter @bairmair/db test:remote && pnpm --filter @bairmair/web test:remote && pnpm --filter @bairmair/mobile test:remote",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --schema public --remote > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "auth:diff": "node supabase/scripts/auth-config.mjs diff",
    "auth:push": "node supabase/scripts/auth-config.mjs push",
    "functions:deploy": "supabase functions deploy send-sms --use-api --no-verify-jwt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "turbo": "2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
