# Read by the Supabase CLI for env(...) values in config.toml. Copy to supabase/.env (gitignored).
SEND_SMS_HOOK_URI=https://<project-ref>.supabase.co/functions/v1/send-sms
# Standard Webhooks secret, "v1,whsec_<base64>". The same value is set as the Edge Function
# secret SEND_SMS_HOOK_SECRET (`pnpm supabase secrets set ... --remote`).
SEND_SMS_HOOK_SECRETS=v1,whsec_...
# Test phone numbers with fixed codes (no SMS), "phone=code,phone=code" (phone without +).
# Pushed by `pnpm auth:push`; never put them in config.toml (the repo is public).
DEV_TEST_OTP=
# Cloudflare Turnstile widget's secret key (Cloudflare dashboard > Turnstile > the widget >
# Settings), for [auth.captcha]: Supabase Auth checks sign-in captcha tokens with it.
TURNSTILE_SECRET_KEY=
