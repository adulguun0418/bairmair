# Read by the Supabase CLI for env(...) values in config.toml. Copy to supabase/.env (gitignored).
SEND_SMS_HOOK_URI=https://<project-ref>.supabase.co/functions/v1/send-sms
# Standard Webhooks secret, "v1,whsec_<base64>". The same value is set as the Edge Function
# secret SEND_SMS_HOOK_SECRET (`pnpm supabase secrets set ... --remote`).
SEND_SMS_HOOK_SECRETS=v1,whsec_...
