# Copy to apps/web/.env.local (gitignored). Dashboard: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public origin of shared links and Open Graph images (no trailing slash). Defaults to
# http://localhost:3000; set it to the deployed site once there is one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only (route handlers). Bypasses RLS; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
# Cloudflare Turnstile for the website's sign-in form (Cloudflare dashboard > Turnstile).
# For local development, Cloudflare's always-pass test keys work:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server only, like SUPABASE_SECRET_KEY.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
