# Copy to apps/web/.env.local (gitignored). Dashboard: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public origin of shared links and Open Graph images (no trailing slash). Defaults to
# http://localhost:3000; set it to the deployed site once there is one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only (route handlers). Bypasses RLS; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
# Cloudflare Turnstile site key for sign-in (website form and the app's /embed/captcha page).
# Supabase Auth checks the tokens with the widget's secret ([auth.captcha] in
# supabase/config.toml), so only the real site key gives tokens it accepts, and only on the
# widget's hostnames (add `localhost` there to sign in from `pnpm dev:web`). Cloudflare's test
# key below renders the widget but its tokens are refused once captcha is on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional. PostHog project API key (`phc_...`, EU cloud: Project settings > Project API key;
# public by design, not a secret API key). Unset = no analytics at all. Set it only in Vercel's
# Production environment, so local development and preview deployments send nothing
# (src/lib/analytics.ts). NEXT_PUBLIC_* values are built into the site: a new value takes effect
# with the next deployment (merge to main, or Redeploy in the Vercel dashboard).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. QPay payments (src/server/payment-env.ts): all five QPAY_* values set = payments on,
# any missing = every payment request answers 503. Set them in Vercel's Production environment
# only: the credentials are the live merchant's, so previews (built from any PR branch of this
# public repo) and local builds create no real invoices. Locally, fill them in only to test.
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
# The merchant's invoice template code, from QPay.
QPAY_INVOICE_CODE=
# Signs the callback URL given to QPay. Any long random string: `openssl rand -base64url 32`.
QPAY_CALLBACK_SECRET=
# Comma-separated user ids allowed to buy `testersOnly` products (the 100₮ test at /payments/test).
PAYMENT_TESTERS=
