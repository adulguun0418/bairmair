# Copy to apps/mobile/.env (gitignored), then restart Metro (`pnpm dev:mobile`).
# These values are bundled into the app; never put a secret key here.
# Dashboard: Project Settings > API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The web app with the API routes. During development: your PC's Wi-Fi IP and `pnpm dev:web`,
# e.g. http://192.168.1.20:3000 (the phone must be on the same network).
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# Optional: the public website for share links. Defaults to EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_SITE_URL=https://your-public-site.example
