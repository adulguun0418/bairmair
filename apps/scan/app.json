{
  "expo": {
    "name": "bairmair scan",
    "slug": "bairmair-scan",
    "version": "0.1.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/8317c6a8-0d5d-4e45-a4f3-292113c1adf0"
    },
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bairmairscan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "mn.bairmair.scan",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      },
      "infoPlist": {}
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-roomplan",
        {
          "cameraPermissionText": "Байраа 3D скан хийх, зураг авахын тулд камер ашиглана."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Скандаа зураг нэмэхийн тулд зургийн санд хандана.",
          "cameraPermission": "Байраа 3D скан хийх, зураг авахын тулд камер ашиглана.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Скан тухайн байранд хийгдсэнийг тэмдэглэхийн тулд байршлыг ашиглана.",
          "locationFullAccuracyPermission": "Байрны байршлыг зөв тэмдэглэхэд нарийн байршил хэрэгтэй.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "adulguun0418",
    "extra": {
      "eas": {
        "projectId": "8317c6a8-0d5d-4e45-a4f3-292113c1adf0"
      }
    }
  }
}
